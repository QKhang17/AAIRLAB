# ==============================================================================
# AAIR LAB - Fullstack Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific credentials.
# NEVER commit the active '.env' file containing secrets to version control.
# This root template is for local development. Production Docker uses the
# external read-only YAML secret documented in deploy/README.md.
# ==============================================================================

# Backend Server Configuration
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
AUTH_COOKIE_SECURE=false
# Lax is recommended when frontend/API share a site; use None only with HTTPS + CSRF enabled.
AUTH_COOKIE_SAMESITE=Lax
# Lax is recommended when frontend/API share a site; use None only with HTTPS + CSRF enabled.
AUTH_COOKIE_SAMESITE=Lax

# Frontend Vite API Base URL
# Use the same-origin proxy locally. Production may set an exact API origin,
# e.g. https://api.example.com/api; never use a wildcard origin.
VITE_API_BASE_URL=/api

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/aair_db
DB_USERNAME=aair_app
DB_PASSWORD=your_secure_db_password

# JWT Security Configuration
# CRITICAL: In production, generate a strong random 256-bit key and never use a sample value.
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes
JWT_EXPIRATION_MS=3600000

# Mail Service Configuration (SMTP - used for sending generated passwords to new users)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_system_email@gmail.com
MAIL_PASSWORD=your_google_app_password
MAIL_FROM=your_system_email@gmail.com

# File Storage Configuration
UPLOAD_DIRECTORY=./uploads

# AI Providers API Keys (Optional)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
